# Variables de entorno — EJEMPLO (NO contiene valores reales)
# Copia este archivo como ".env" y completa los valores en tu entorno local.
# NUNCA subas el archivo ".env" real al repositorio.
#
# --- Públicas (frontend, prefijo VITE_) — pueden ir en el bundle del navegador ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# --- Lado servidor (NO usar prefijo VITE_, NUNCA exponer en el frontend) ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=

# --- SECRETOS: se gestionan en Lovable Cloud / Supabase, NO en este archivo ---
# SUPABASE_SERVICE_ROLE_KEY  (clave privada — solo lado servidor)
# SUPABASE_DB_URL            (cadena de conexión — solo lado servidor)
# LOVABLE_API_KEY            (clave de IA — solo lado servidor)
